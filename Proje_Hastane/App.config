<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Veritabanı bağlantısı burada tanımlı. Başka bir bilgisayarda çalıştırırken
             sadece "Data Source" kısmını o bilgisayardaki SQL Server adına göre değiştirmek yeterli.
             ".\SQLEXPRESS" = bu bilgisayardaki SQLEXPRESS sunucusu. -->
        <add name="HastaneProje"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=HastaneProje;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
